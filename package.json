{
  "name": "campus-food-order",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:user": "pnpm --filter @campus-food/user dev",
    "dev:admin": "pnpm --filter @campus-food/admin dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:user": "pnpm --filter @campus-food/user build",
    "build:admin": "pnpm --filter @campus-food/admin build",
    "preview:user": "pnpm --filter @campus-food/user preview",
    "preview:admin": "pnpm --filter @campus-food/admin preview",
    "type-check": "pnpm -r --parallel type-check",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "clean": "pnpm -r exec rm -rf node_modules dist && rm -rf node_modules"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=9.0.0"
  }
}
